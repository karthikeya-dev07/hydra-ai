# HYDRA AI Environment Configuration

# Backend
BACKEND_URL=http://localhost:8000
WEBSOCKET_URL=ws://localhost:8000/ws/traffic

# Mapbox (optional - for real maps)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# AI Model
YOLO_MODEL_PATH=yolo11n.pt
USE_DEEPSORT=true
AI_DEVICE=auto

# Database (optional)
DATABASE_URL=postgresql://localhost:5432/hydra

# Redis (optional)
REDIS_URL=redis://localhost:6379
